# Any model identifier supported by LiteLLM.
# Example: openrouter/anthropic/claude-sonnet-4
CORPUS_LLM_MODEL=
CORPUS_LLM_API_KEY=

# Semantic chunking embeddings. Unprefixed models use OpenRouter.
# Example: qwen/qwen3-embedding-8b
CORPUS_EMBEDDER_MODEL=

# Optional overrides.
CORPUS_LLM_API_BASE=
CORPUS_LLM_TEMPERATURE=0.1
CORPUS_LLM_MAX_TOKENS=16384
